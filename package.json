{
  "name": "ai-health-companion",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "postinstall": "pnpm --filter @aidoctor/api run prisma:generate",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @aidoctor/api prisma generate",
    "db:migrate": "pnpm --filter @aidoctor/api prisma migrate dev",
    "db:studio": "pnpm --filter @aidoctor/api prisma studio",
    "db:seed": "pnpm --filter @aidoctor/api prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "body-parser": "^2.4.0",
      "qs": "^6.16.0",
      "js-yaml": "^5.4.1",
      "postcss": "^8.5.23",
      "nanoid": "^3.3.18",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "multer": "^2.5.0",
      "deepmerge-ts": "^8.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "@scarf/scarf",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
