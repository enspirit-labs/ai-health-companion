NODE_ENV=development
PORT=3001

# Local Postgres (see docker-compose.yml at repo root)
# connection_limit/pool_timeout are explicit rather than left to Prisma's
# implicit default (num_cpus * 2 + 1) — under bursty concurrent traffic an
# unbounded-feeling pool either starves (too small) or opens more physical
# connections than Postgres's max_connections allows (too large, and fatal
# once multiple API instances share the same DB). Size connection_limit to
# (Postgres max_connections / number of API instances), leaving headroom for
# migrations/admin tools.
DATABASE_URL="postgresql://aidoctor:aidoctor@localhost:5432/aidoctor?schema=public&connection_limit=10&pool_timeout=20"

# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-64-char-hex-secret-min-32-chars-required"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Supabase (Auth + Storage) — leave blank to run against the local auth provider
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="health-media"

# Admin user created by `pnpm db:seed`. Both must be set or the seed skips
# the admin (in every environment, including production) — there is no
# built-in default. Use a unique password; it is bcrypt-hashed before storage.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# AI providers — leave blank to run against the local mock AI provider
ANTHROPIC_API_KEY=""
# Model ID. The code default is for local dev only; NODE_ENV=production refuses to start unless this is set.
ANTHROPIC_MODEL=""
# Small fast model for the chat safety classifier (optional; default claude-haiku-5-5)
ANTHROPIC_SAFETY_MODEL=""
# Model-assisted safety classifier behind the red-flag rules (default on). Set to "false" or "0" to
# turn it off. One extra small-model call per chat message the rules did not catch, 4 s timeout.
SAFETY_CLASSIFIER_ENABLED="true"
OPENAI_API_KEY=""

WEB_APP_URL="http://localhost:4000"

# Local testing only: there is no email provider yet, so set this to "true" to
# have forgot-password return the reset token in its response. Always ignored
# when NODE_ENV=production (password reset is not deliverable there yet).
EXPOSE_DEV_RESET_TOKEN="false"
